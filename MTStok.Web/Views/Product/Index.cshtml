@{
    ViewData["Title"] = "Ürünler";
}

<div class="animate-in fade-in slide-in-from-bottom-4 duration-700">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h3 class="text-3xl font-bold text-white tracking-tight">Ürün Yönetimi</h3>
            <p class="text-slate-400 mt-1 font-medium italic">Depodaki tüm ürünlerin listesi ve stok durumları.</p>
        </div>
        <a asp-controller="Product" asp-action="Create" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-500/20 active:scale-95">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Yeni Ürün Ekle
        </a>
    </div>

    <!-- Ürün Tablosu -->
    <div class="bg-slate-900/40 border border-slate-800/50 rounded-3xl overflow-hidden shadow-2xl">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-900/60 border-b border-slate-800 text-slate-500 text-[10px] font-bold uppercase tracking-widest">
                    <th class="p-6">Ürün Bilgisi</th>
                    <th class="p-6">Kategori</th>
                    <th class="p-6">Stok Adet</th>
                    <th class="p-6">Birim Fiyat</th>
                    <th class="p-6">Durum</th>
                    <th class="p-6 text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50 text-slate-300">
                <tr class="hover:bg-indigo-500/5 transition-colors group">
                    <td class="p-6">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 bg-indigo-500/10 rounded-xl flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
                                <i data-lucide="monitor" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-white leading-tight">Nvidia RTX 4090</p>
                                <p class="text-[10px] text-slate-500 font-mono mt-1">#PRD-94821</p>
                            </div>
                        </div>
                    </td>
                    <td class="p-6 text-sm">Ekran Kartı</td>
                    <td class="p-6 font-mono text-sm">12 Adet</td>
                    <td class="p-6 text-sm font-bold text-white">₺54,999</td>
                    <td class="p-6">
                        <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">Stokta</span>
                    </td>
                    <td class="p-6 text-right">
                        <button class="text-slate-500 hover:text-white transition-colors p-2 hover:bg-slate-800 rounded-lg"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                        <button class="text-slate-500 hover:text-rose-500 transition-colors p-2 hover:bg-rose-500/10 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                    </td>
                </tr>
                <!-- Daha fazla mock veri eklenebilir -->
            </tbody>
        </table>
    </div>
</div>