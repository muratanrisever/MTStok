<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MTStok</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background-color: #020617;
            color: #e2e8f0;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 10px;
        }

        .glass-sidebar {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(16px);
            border-right: 1px solid rgba(30, 41, 59, 0.5);
        }

        .nav-link-active {
            background: rgba(79, 70, 229, 0.1);
            color: #818cf8;
            border: 1px solid rgba(79, 70, 229, 0.2);
        }
    </style>
</head>
<body class="overflow-hidden">

    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();

        // Mock Session Bilgisi (TempData'dan kalıcı hale getiriyoruz)
        var userRole = TempData.Peek("UserRole")?.ToString() ?? "User";
        var userName = TempData.Peek("UserName")?.ToString() ?? "Misafir";
    }

    <div class="flex h-screen">
        <aside class="w-72 glass-sidebar flex flex-col z-20">
            <div class="p-8 flex items-center gap-3">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-500/20 rotate-2">
                    <i data-lucide="package" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white leading-none">MTStok</h1>
                    <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-[0.2em] mt-1">Enterprise UI</p>
                </div>
            </div>

            <nav class="flex-1 px-4 py-4 space-y-1.5 overflow-y-auto custom-scrollbar">
                <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3 mt-2">Menü</p>

                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Home" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                    <span class="font-semibold text-sm">Dashboard</span>
                </a>

                <a asp-controller="Products" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Product" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                    <i data-lucide="box" class="w-5 h-5"></i>
                    <span class="font-semibold text-sm">Ürünler</span>
                </a>

                <a asp-controller="Category" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Category" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                    <i data-lucide="box" class="w-5 h-5"></i>
                    <span class="font-semibold text-sm">Kategoriler</span>
                </a>

                @if (userRole == "SystemAdmin")
                {
                    <div class="pt-6">
                        <p class="px-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-3 text-slate-500">Sistem Yönetimi</p>

                        <a asp-controller="Admin" asp-action="Users" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Admin" && currentAction == "Users" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                            <i data-lucide="users" class="w-5 h-5"></i>
                            <span class="font-semibold text-sm">Kullanıcı Yönetimi</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Roles" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Admin" && currentAction == "Roles" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                            <i data-lucide="shield-check" class="w-5 h-5"></i>
                            <span class="font-semibold text-sm">Rol Yönetimi</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Maintenance" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Admin" && currentAction == "Maintenance" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                            <i data-lucide="settings-2" class="w-5 h-5"></i>
                            <span class="font-semibold text-sm">Sistem Bakımı</span>
                        </a>

                        <a asp-controller="Log" asp-action="Index" class="flex items-center gap-3 p-3.5 rounded-xl transition-all @(currentController == "Log" ? "nav-link-active" : "text-slate-400 hover:text-white hover:bg-slate-800/40")">
                            <i data-lucide="terminal" class="w-5 h-5"></i>
                            <span class="font-semibold text-sm">Loglar</span>
                        </a>
                    </div>
                }
            </nav>

            <div class="p-4 border-t border-slate-800/50 bg-[#0f172a]/20">
                <div class="flex items-center gap-3 p-3 bg-slate-900/40 rounded-2xl border border-slate-800/50">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-cyan-500 flex items-center justify-center text-white font-bold shadow-inner uppercase">
                        @(userName.Length > 0 ? userName.Substring(0, 1) : "M")
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold text-white truncate">@userName</p>
                        <p class="text-[10px] text-cyan-400 font-bold uppercase tracking-wider">@userRole</p>
                    </div>
                    <a asp-controller="Account" asp-action="Logout" class="text-slate-500 hover:text-rose-500 transition-colors">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </a>
                </div>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0 overflow-hidden relative">
            <header class="h-20 border-b border-slate-800/50 bg-[#020617]/80 backdrop-blur-md px-8 flex items-center justify-between z-10">
                <div class="flex items-center gap-4">
                    <div class="h-8 w-1.5 bg-indigo-500 rounded-full shadow-[0_0_15px_rgba(79,70,229,0.5)]"></div>
                    <h2 class="text-lg font-bold text-white tracking-tight">@ViewData["PageHeader"]</h2>
                </div>
            </header>
            <main class="flex-1 overflow-y-auto p-8 custom-scrollbar bg-slate-950">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>lucide.createIcons();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>