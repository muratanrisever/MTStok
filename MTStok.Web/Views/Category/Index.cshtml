@model IEnumerable<MTStok.Application.DTOs.Category.CategoryListDto>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-in fade-in slide-in-from-bottom-4 duration-700">

    <!-- Sol: Kategori Ekleme Formu -->
    <div class="lg:col-span-1">
        <div class="bg-slate-900/40 border border-slate-800/50 rounded-3xl p-8 sticky top-8 shadow-2xl">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-12 bg-indigo-600/20 rounded-2xl flex items-center justify-center text-indigo-400 border border-indigo-500/20">
                    <i data-lucide="tags" class="w-6 h-6"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Yeni Kategori</h3>
                    <p class="text-xs text-slate-500 mt-1">Sisteme kategori ekleyin.</p>
                </div>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="mb-6 p-4 bg-rose-500/10 border border-rose-500/20 rounded-xl text-rose-400 text-xs font-bold">
                    <i data-lucide="alert-circle" class="w-4 h-4 inline-block mr-1"></i> @TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-400 text-xs font-bold">
                    <i data-lucide="check-circle" class="w-4 h-4 inline-block mr-1"></i> @TempData["Success"]
                </div>
            }

            <form asp-action="Create" method="post" class="space-y-4">
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase tracking-widest text-slate-500 ml-1">Kategori Adı</label>
                    <input name="Name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm focus:border-indigo-500 text-white outline-none" placeholder="Örn: Elektronik">
                </div>
                <button type="submit" class="w-full py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold mt-2 shadow-lg shadow-indigo-500/20 transition-all uppercase tracking-widest">
                    Kategoriyi Kaydet
                </button>
            </form>
        </div>
    </div>

    <!-- Sağ: Kategori Listesi -->
    <div class="lg:col-span-2">
        <div class="bg-slate-900/40 border border-slate-800/50 rounded-3xl overflow-hidden shadow-2xl">
            <div class="p-8 border-b border-slate-800/50 flex justify-between items-center">
                <h3 class="text-lg font-bold text-white">Mevcut Kategoriler</h3>
                <span class="bg-indigo-600/20 text-indigo-400 text-[10px] font-bold px-3 py-1 rounded-full border border-indigo-500/20">
                    Toplam: @(Model?.Count() ?? 0)
                </span>
            </div>

            <table class="w-full text-left">
                <tbody class="divide-y divide-slate-800/50 text-slate-300">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-800/30 transition-colors group">
                                <td class="p-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-10 h-10 bg-slate-950 rounded-xl flex items-center justify-center text-slate-500 group-hover:text-indigo-400 border border-slate-800 transition-all">
                                            <i data-lucide="tag" class="w-4 h-4"></i>
                                        </div>
                                        <p class="text-sm font-bold text-white">@item.Name</p>
                                    </div>
                                </td>
                                <td class="p-6 text-right">
                                    <button class="p-2 hover:bg-rose-500/10 rounded-lg text-slate-600 hover:text-rose-500 transition-all"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="p-16 text-center">
                                <p class="text-slate-500 text-sm">Henüz sistemde hiç kategori bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>