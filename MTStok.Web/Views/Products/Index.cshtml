@model IEnumerable<MTStok.Application.DTOs.Products.ProductListDto>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="animate-in fade-in slide-in-from-bottom-4 duration-700">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h3 class="text-3xl font-bold text-white tracking-tight">Ürün Yönetimi</h3>
            <p class="text-slate-400 mt-1 font-medium italic">Envanterdeki tüm ürünleri ve stok durumlarını buradan takip edin.</p>
        </div>
        <a asp-action="Create" class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-xl font-bold transition-all shadow-lg shadow-indigo-500/20 active:scale-95">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Yeni Ürün Ekle
        </a>
    </div>

    <!-- Uyarı Mesajları (Ekleme/Hata İşlemleri İçin) -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center gap-3 text-emerald-400 text-sm">
            <i data-lucide="check-circle" class="w-5 h-5"></i> @TempData["Success"]
        </div>
    }

    <!-- Ürün Tablosu -->
    <div class="bg-slate-900/40 border border-slate-800/50 rounded-3xl overflow-hidden shadow-2xl">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-900/60 border-b border-slate-800 text-slate-500 text-[10px] font-bold uppercase tracking-widest">
                    <th class="p-6">Ürün Detayı</th>
                    <th class="p-6">Kategori</th>
                    <th class="p-6">Mevcut Stok</th>
                    <th class="p-6">Fiyat</th>
                    <th class="p-6">Durum</th>
                    <th class="p-6 text-right">Eylem</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/50 text-slate-300">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-indigo-500/5 transition-colors group">
                            <td class="p-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center text-indigo-400 group-hover:bg-indigo-600/20 transition-all border border-slate-700/50">
                                        <i data-lucide="package" class="w-6 h-6"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-white">@item.Name</p>
                                        <p class="text-[10px] text-slate-500 font-mono mt-1">@item.ProductCode</p>
                                    </div>
                                </div>
                            </td>
                            <td class="p-6">
                                <span class="bg-slate-900 px-3 py-1 rounded-lg text-xs border border-slate-800">@item.CategoryName</span>
                            </td>
                            <td class="p-6 text-sm font-mono">@item.StockQuantity Adet</td>
                            <td class="p-6 text-sm font-bold text-indigo-400 font-sans">@item.Price.ToString("C2")</td>
                            <td class="p-6">
                                <div class="flex items-center gap-2">
                                    <div class="w-2 h-2 rounded-full @(item.StockQuantity > 0 ? "bg-emerald-500" : "bg-rose-500")"></div>
                                    <span class="text-[10px] font-bold @(item.StockQuantity > 0 ? "text-emerald-500" : "text-rose-500") uppercase tracking-tighter">
                                        @(item.StockQuantity > 0 ? "Stokta Var" : "Tükendi")
                                    </span>
                                </div>
                            </td>
                            <td class="p-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="p-2 hover:bg-slate-800 rounded-lg text-slate-500 hover:text-white transition-all"><i data-lucide="edit-3" class="w-4 h-4"></i></button>
                                    <button class="p-2 hover:bg-rose-500/10 rounded-lg text-slate-500 hover:text-rose-500 transition-all"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="p-16 text-center">
                            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-800 text-slate-500 mb-4">
                                <i data-lucide="inbox" class="w-8 h-8"></i>
                            </div>
                            <p class="text-slate-400 font-medium">Henüz sisteme hiç ürün eklenmemiş.</p>
                            <p class="text-xs text-slate-500 mt-1">Hemen sağ üstten yeni bir ürün tanımlayabilirsiniz.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>